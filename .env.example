# Vera 2.0 — Environment Configuration
# Copy this to .env and fill in your values

# LLM Provider: openai | anthropic | gemini | deepseek
LLM_PROVIDER=openai

# Your API key (required for LLM-powered composition)
LLM_API_KEY=

# Model (leave blank for provider default)
# Examples: gpt-4o, claude-sonnet-4-20250514, gemini-2.5-flash
LLM_MODEL=

# Server
HOST=0.0.0.0
PORT=8080

# Team
TEAM_NAME=Vera 2.0
TEAM_MEMBERS=Janvi
CONTACT_EMAIL=
